# Copy to .env and adjust for your environment

# Database
POSTGRES_DB=tosk
POSTGRES_USER=tosk
POSTGRES_PASSWORD=tosk

# Spring datasource (container-to-container)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/tosk
SPRING_DATASOURCE_USERNAME=tosk
SPRING_DATASOURCE_PASSWORD=tosk

# Active profile (local/docker/prod)
SPRING_PROFILES_ACTIVE=docker

# JWT private JWKS (Base64, contains private keys). Prefer this in prod.
# APP_JWT_PRIVATE_JWKS_B64=

# Alternatively for local dev, use PEM file paths generated under dev/certs
# APP_JWT_PRIVATE_KEY_PATH=dev/certs/private_key.pem
# APP_JWT_PUBLIC_KEY_PATH=dev/certs/public_key.pem

# JVM options
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -Duser.timezone=UTC -Dfile.encoding=UTF-8

# ---- App (Frontend URL / Mail)
# URL used to build verification/reset links
APP_FRONTEND_BASE_URL=http://localhost:3000

# Mail provider: logging | smtp | resend
APP_MAIL_PROVIDER=logging
APP_MAIL_FROM=no-reply@tosk.local
APP_MAIL_SUBJECT_PREFIX=[TOSK] 

# SMTP (when APP_MAIL_PROVIDER=smtp)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Resend (when APP_MAIL_PROVIDER=resend)
RESEND_API_KEY=

# ---- Auth Cookies
# SameSite: Strict | Lax | None
APP_JWT_COOKIE_SAME_SITE=Strict
# Secure on/off (prod must be true)
APP_JWT_COOKIE_SECURE=false
# Cookie names
APP_JWT_ACCESS_COOKIE=AT
APP_JWT_REFRESH_COOKIE=RT
# Cookie paths (adjust to your API paths)
APP_JWT_ACCESS_COOKIE_PATH=/
APP_JWT_REFRESH_COOKIE_PATH=/api/auth
