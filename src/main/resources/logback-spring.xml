<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="tosk"/>

    <!-- Development / Docker: human-readable console -->
    <springProfile name="default,local,docker">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX} %-5level [%thread] %logger{36} - rid=%X{requestId:-} %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

    <!-- Production: JSON logs with requestId and metadata -->
    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <pattern>
                        <pattern>
                            {"level":"%level","logger":"%logger","thread":"%thread"}
                        </pattern>
                    </pattern>
                    <mdc/>
                    <arguments/>
                    <stackTrace/>
                    <provider class="net.logstash.logback.composite.loggingevent.MessageJsonProvider"/>
                    <provider class="net.logstash.logback.composite.GlobalCustomFieldsJsonProvider">
                        <customFields>{"application":"${APP_NAME}"}</customFields>
                    </provider>
                </providers>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>

